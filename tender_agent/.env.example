# Telegram Bot (create via @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Telegram Chat ID (get via @userinfobot or @getmyid_bot)
TELEGRAM_CHAT_ID=your_chat_id

# Claude API key (optional - for AI relevance scoring)
# Without this, basic keyword-based scoring will be used
ANTHROPIC_API_KEY=your_anthropic_api_key
